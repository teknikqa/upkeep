#!/usr/bin/env bash
# Commit-msg hook: enforces Conventional Commits format via commitlint.
# See: https://www.conventionalcommits.org/ and https://commitlint.js.org/
set -euo pipefail

MSG_FILE="$1"

if ! command -v pnpm >/dev/null 2>&1; then
    echo "==> pnpm not found — skipping commitlint (install: https://pnpm.io/installation)"
    exit 0
fi

if [ ! -d node_modules/@commitlint ]; then
    echo "==> commitlint not installed — skipping (run: pnpm install)"
    exit 0
fi

pnpm exec commitlint --edit "$MSG_FILE"
